ENV=dev
DATABASE_TYPE=sqlite
STORAGE_TYPE=local

# API Keys
OPENAI_API_KEY=sk-...
LLAMA_CLOUD_API_KEY=llx-...
COHERE_API_KEY=...

# Qdrant
QDRANT_URL=http://localhost:6333

# Postgres (Prod)
# Note: If running locally against Docker Postgres, use localhost:5400 (as mapped in docker-compose)
# If running inside Docker network, use postgres:5432
POSTGRES_URL=postgresql://user:password@localhost:5400/ragdb

# S3 / MinIO (Prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=rag-bucket
S3_REGION=us-east-1
