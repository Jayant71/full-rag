# ================================================
# Backend Environment Variables
# ================================================
# Copy this file to .env and fill in the values

# Environment
ENV=dev  # dev or prod

# ================================================
# Supabase (Required)
# ================================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-key

# ================================================
# Database (Required)
# ================================================
# Options: sqlite (for local dev) or postgres (for production/Supabase)

# --- For Local Development ---
DATABASE_TYPE=sqlite

# --- For Production (Supabase PostgreSQL) ---
# DATABASE_TYPE=postgres
# Get connection string from: Supabase Dashboard > Settings > Database > Connection string (URI)
# POSTGRES_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ================================================
# File Storage (Required)
# ================================================
# Options: local, s3, supabase
STORAGE_TYPE=supabase

# --- Option 1: Local Storage ---
# Files stored in app_data/uploads/ folder

# --- Option 2: S3/MinIO ---
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=rag-bucket
# S3_REGION=us-east-1

# --- Option 3: Supabase Storage (Recommended) ---
# Uses the 'documents' bucket - no extra config needed

# ================================================
# CORS (Required)
# ================================================
FRONTEND_URL=http://localhost:5173

# ================================================
# BYOK - User Provided Keys
# ================================================
# Users provide their own keys via Settings page:
# - OpenAI API Key (required)
# - LlamaCloud API Key (required)
# - Qdrant URL (required)
# - Cohere API Key (optional)
